# Copia este archivo como .env.local y llena los valores.

# --- Supabase (Dashboard → Project Settings → API) ---
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_ANON_KEY"

# --- Stripe (Dashboard → Developers → API keys, en MODO PRUEBA) ---
# Clave secreta: solo la usa el servidor (server/payments.ts). NUNCA le pongas prefijo VITE_.
STRIPE_SECRET_KEY="sk_test_..."
# Opcional: solo si usas webhooks con `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""

# --- Opcional ---
# URL pública de la app para los enlaces de regreso de Stripe. Si se omite, se usa la del navegador.
APP_URL=""

# GEMINI_API_KEY: solo la usa AI Studio; la app no la necesita para correr en local.
GEMINI_API_KEY=""
